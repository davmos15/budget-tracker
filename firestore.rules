rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // Email invites only count for addresses the user has proven they own
    function verifiedEmail() {
      return signedIn() && request.auth.token.email != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }

    // User document rules
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      // Owner has full write access
      allow create, delete: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (
        request.auth.uid == userId ||
        // Allow other authenticated users to only modify sharedBudgets (for invite-by-email)
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedBudgets'])
      );

      // User's budgets subcollection
      match /budgets/{budgetId} {
        function isMember() {
          return signedIn() && request.auth.uid in resource.data.info.members;
        }
        function isAdmin() {
          return request.auth.uid in resource.data.info.get('admins', []) || request.auth.uid == resource.data.info.createdBy;
        }
        function infoKeysChanged() {
          return request.resource.data.info.diff(resource.data.info).affectedKeys();
        }
        // The only change is the caller adding themselves to members
        function onlyAddsSelf() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['info']) &&
            infoKeysChanged().hasOnly(['members']) &&
            request.resource.data.info.members.hasAll(resource.data.info.members) &&
            request.resource.data.info.members.size() == resource.data.info.members.size() + 1 &&
            request.auth.uid in request.resource.data.info.members;
        }
        // Proves they know the invite code: a join record can only be made by
        // someone who has the code (codes can't be listed)
        function knowsCode() {
          return resource.data.info.get('code', '') != '' &&
            exists(/databases/$(database)/documents/budgetCodes/$(resource.data.info.code)/joins/$(request.auth.uid));
        }
        function wasInvitedByEmail() {
          return verifiedEmail() && myEmail() in resource.data.info.get('invitedEmails', []);
        }

        // Only members can read
        allow read: if isMember();

        // Only the budget owner can create budgets in their collection
        allow create: if signedIn() &&
          request.auth.uid == userId &&
          request.auth.uid == request.resource.data.info.createdBy &&
          request.auth.uid in request.resource.data.info.members &&
          request.auth.uid in request.resource.data.info.admins;

        // Members can update, but only admins can change members/admins/invites.
        // Non-members can join only with the code or an email invite.
        allow update: if signedIn() && (
          (isMember() && (!infoKeysChanged().hasAny(['members', 'admins', 'invitedEmails']) || isAdmin())) ||
          (!isMember() && onlyAddsSelf() && (knowsCode() || wasInvitedByEmail()))
        );

        // Only the creator can delete
        allow delete: if signedIn() && request.auth.uid == resource.data.info.createdBy;

        // Imported transactions and their settings: members only
        match /{sub}/{docId} {
          allow read, write: if signedIn() && sub in ['txMonths', 'txMeta'] &&
            request.auth.uid in get(/databases/$(database)/documents/users/$(userId)/budgets/$(budgetId)).data.info.members;
        }
      }
    }

    // Pending invites for users who haven't signed in yet.
    // Readable/deletable only by the verified owner of that email. Anyone signed in
    // may leave one — it grants nothing by itself (joining also needs info.invitedEmails).
    match /pendingInvites/{email} {
      allow get, delete: if verifiedEmail() && myEmail() == email;
      allow create, update: if signedIn();
    }

    // Email lookup collection for invite-by-email: look up one address, never list.
    // Users can only write their own email entry
    match /userEmails/{email} {
      allow get: if signedIn();
      allow create, update: if signedIn() &&
        request.resource.data.uid == request.auth.uid;
    }

    // Budget code lookup: look up one code, never list.
    // Only the budget owner can create/update their code entry
    match /budgetCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() &&
        resource.data.ownerId == request.auth.uid;

      // A join record proves the joiner knew the code
      match /joins/{uid} {
        allow create: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
